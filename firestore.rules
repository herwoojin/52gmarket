rules_version = '2';

// 오이(52)지마켓 Firestore 보안 규칙
//
// 인증: 앱스크립트가 사내 이메일 OTP 인증 후 커스텀 토큰을 발급하고,
//       프론트가 signInWithCustomToken 으로 로그인한다.
//       따라서 request.auth.uid == 사내 이메일 이다.
//
// 원칙: 로그인하지 않으면 아무것도 읽거나 쓸 수 없다.
//       특히 1:1 대화는 참여자 본인만 접근할 수 있어야 한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── 매물 ──
    // 읽기: 로그인한 직원 누구나 (사내 마켓이므로)
    // 쓰기: 본인이 등록한 매물만 수정/삭제
    match /products/{productId} {
      allow read: if signedIn();

      // 등록 시 uid 를 본인 것으로만 설정할 수 있다
      allow create: if isSelf(request.resource.data.uid);

      // 소유자는 전체 수정 가능.
      // 소유자가 아니어도 찜/대화 카운터와 거래완료 처리는 허용해야 하므로
      // 변경 가능한 필드를 명시적으로 제한한다.
      allow update: if isSelf(resource.data.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['jjim', 'chats', 'status']));

      // 실제 삭제는 막고 status='삭제' 로만 처리 (이력 보존)
      allow delete: if false;
    }

    // ── 대화방 ──
    // 참여자 본인만 읽고 쓸 수 있다
    match /rooms/{roomId} {
      // 아직 만들어지지 않은 방(resource == null)은 조회를 허용한다.
      // 대화를 처음 시작할 때 앱이 방 존재 여부를 확인해야 하고,
      // 없는 문서에서는 유출될 정보 자체가 없다.
      // 목록 조회 시에는 resource 가 항상 존재하므로 참여자 검사가 그대로 적용된다.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        function roomRef() {
          return /databases/$(database)/documents/rooms/$(roomId);
        }
        function isParticipant() {
          return signedIn()
            && exists(roomRef())
            && request.auth.uid in get(roomRef()).data.participants;
        }

        // 아직 방이 없으면 읽을 메시지도 없으므로 허용한다.
        // (막으면 새 대화를 열 때 구독이 거부돼 화면이 로딩에서 멈춘다)
        allow read: if signedIn() && (!exists(roomRef()) || isParticipant());

        // 작성은 방이 존재하고 참여자일 때만. 발신자 사칭도 차단한다.
        allow create: if isParticipant() && isSelf(request.resource.data.senderUid);

        // 보낸 메시지는 수정·삭제 불가
        allow update, delete: if false;
      }
    }

    // ── 읽음 상태 ──
    // 문서 id = {uid}__{roomId} — 본인 것만
    match /reads/{readId} {
      allow read, write: if isSelf(request.resource.data.uid)
        || (resource != null && isSelf(resource.data.uid));
    }

    // ── 포인트 기록 ──
    // 문서 id = productId (한 매물당 1회만 적립)
    // 랭킹 집계를 위해 로그인한 직원은 모두 읽을 수 있다.
    match /points/{productId} {
      allow read: if signedIn();

      // 적립 대상(uid)이 해당 매물의 실제 주인과 일치해야 한다.
      // 본인 확인이 아니라 '매물 주인 확인'이라, 거래 상대나 관리자가
      // 완료 처리·소급 적립을 해도 포인트는 항상 주인에게만 쌓인다.
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/products/$(productId))
        && request.resource.data.uid
             == get(/databases/$(database)/documents/products/$(productId)).data.uid;

      // 한 번 적립된 포인트는 수정·삭제 불가 (매물이 삭제돼도 기록은 남는다)
      allow update, delete: if false;
    }

    // ── 키워드 알림 설정 ──
    match /keywords/{uid} {
      allow read, write: if isSelf(uid);
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
