rules_version = '2';

// 오이(52)지마켓 Firestore 보안 규칙
//
// 인증: 앱스크립트가 사내 이메일 OTP 인증 후 커스텀 토큰을 발급하고,
//       프론트가 signInWithCustomToken 으로 로그인한다.
//       따라서 request.auth.uid == 사내 이메일 이다.
//
// 원칙: 로그인하지 않으면 아무것도 읽거나 쓸 수 없다.
//       특히 1:1 대화는 참여자 본인만 접근할 수 있어야 한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── 매물 ──
    // 읽기: 로그인한 직원 누구나 (사내 마켓이므로)
    // 쓰기: 본인이 등록한 매물만 수정/삭제
    match /products/{productId} {
      allow read: if signedIn();

      // 등록 시 uid 를 본인 것으로만 설정할 수 있다
      allow create: if isSelf(request.resource.data.uid);

      // 소유자는 전체 수정 가능.
      // 소유자가 아니어도 찜/대화 카운터와 거래완료 처리는 허용해야 하므로
      // 변경 가능한 필드를 명시적으로 제한한다.
      allow update: if isSelf(resource.data.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['jjim', 'chats', 'status']));

      // 실제 삭제는 막고 status='삭제' 로만 처리 (이력 보존)
      allow delete: if false;
    }

    // ── 대화방 ──
    // 참여자 본인만 읽고 쓸 수 있다
    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        function inRoom() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
        }
        allow read: if inRoom();
        // 발신자를 본인으로만 기록할 수 있다 (사칭 방지)
        allow create: if inRoom() && isSelf(request.resource.data.senderUid);
        // 보낸 메시지는 수정·삭제 불가
        allow update, delete: if false;
      }
    }

    // ── 읽음 상태 ──
    // 문서 id = {uid}__{roomId} — 본인 것만
    match /reads/{readId} {
      allow read, write: if isSelf(request.resource.data.uid)
        || (resource != null && isSelf(resource.data.uid));
    }

    // ── 키워드 알림 설정 ──
    match /keywords/{uid} {
      allow read, write: if isSelf(uid);
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
