rules_version = '2';

// 오이(52)지마켓 Firebase Storage 보안 규칙
//
// 매물 사진 저장 경로: listings/{uid}/{파일명}
// 인증은 Firestore 와 동일하게 앱스크립트 OTP → 커스텀 토큰 방식이다.

service firebase.storage {
  match /b/{bucket}/o {

    match /listings/{uid}/{fileName} {
      // 사내 직원(로그인한 사용자)이면 사진을 볼 수 있다
      allow read: if request.auth != null;

      // 업로드는 본인 폴더에만, 이미지 파일 5MB 이하로 제한
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 그 외 경로는 모두 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
